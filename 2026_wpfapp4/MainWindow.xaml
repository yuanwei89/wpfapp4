        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_wpfapp4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Menu  Height="30" DockPanel.Dock="Top">
            <MenuItem Header="檔案" Height="30" VerticalAlignment="Center" FontSize="16">
            <MenuItem  Header="開啟新畫布"  VerticalAlignment="Center" FontSize="16"/>
            <MenuItem  Header="儲存畫布"  VerticalAlignment="Center" FontSize="16"/>
            </MenuItem>
        </Menu>
        <ToolBarTray Height="40" Background="#FFD3E9F7" DockPanel.Dock="Top">

        </ToolBarTray>
        <StatusBar Height="35"   Background="#FFC1E1F5" DockPanel.Dock="Bottom">

        </StatusBar>
        <Canvas  Background="#FFDFFDD7"/>
    </DockPanel>
</Window>
